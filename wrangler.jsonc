{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poletto-dev-rebuild",
  "compatibility_date": "2026-09-09",
  // The site is static files; the Worker only handles the first-party
  // analytics beacon (see src/worker/index.ts). Every other request is served
  // straight from assets without invoking it.
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/s/e"]
  }
}
